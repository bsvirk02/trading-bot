<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bhavdeepvirk.trading-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/bhavdeepvirk/Trading Bot Project/run_daily.sh</string>
    </array>

    <!-- live_bot.py does `from config import ...`, so it must run with the
         project directory as cwd or the import fails. -->
    <key>WorkingDirectory</key>
    <string>/Users/bhavdeepvirk/Trading Bot Project</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/bhavdeepvirk/Trading Bot Project/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bhavdeepvirk/Trading Bot Project/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
